<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildThisFileDirectory)..\Game</GameDir>
  </PropertyGroup>
</Project>
