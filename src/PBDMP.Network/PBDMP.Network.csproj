<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net6.0</TargetFramework></PropertyGroup>
  <Target Name="GenerateModVersion" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)ModVersion.g.cs"
                      Lines="namespace PBDMP.Network { public static class ModVersion { public const string Value = &quot;$(Version)&quot;%3B } }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ModVersion.g.cs" />
    </ItemGroup>
  </Target>
</Project>
